{
  "name": "pixel-cat-3d-generator",
  "version": "3.0.0",
  "description": "参数化 3D 像素猫生成器 — Vue 3 + Three.js 交互预览与 GLB 导出",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1118",
    "build": "vite build",
    "preview": "vite preview",
    "audit:data": "node scripts/audit-metadata.mjs",
    "catalog:build": "node scripts/audit-metadata.mjs --write && node scripts/build-trait-manifest.mjs",
    "manifest:build": "node scripts/build-trait-manifest.mjs",
    "audit:full": "node scripts/build-full-token-audit.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:data": "npm run test && npm run audit:data"
  },
  "dependencies": {
    "pinia": "^2.1.7",
    "three": "^0.160.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
